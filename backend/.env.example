# Name: Rahul Singh Bana
# Email: bana.saa@gmail.com
# LinkedIn: https://www.linkedin.com/in/rahulsinghbana
# Repo: https://github.com/rahulbana/enterprise-document-intelligence
#
# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME="Document Intelligence"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Generate a real one with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Database ---
# SQLite for dev. For Postgres (Phase 8+, see README.md "Switching to
# Postgres"): postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=sqlite:///./document_intelligence.db

# --- Redis / Celery (broker/result backend + short-term chat memory) ---
# Set false to skip ingestion entirely (uploads stay PENDING, no attempt to
# reach Redis/Celery) — for dev without them running yet.
CELERY_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# --- Weaviate (vector store) ---
WEAVIATE_URL=http://localhost:8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY=

# --- File storage (local now, S3/GCS backend added later) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# --- Ingestion (Phase 3): character budgets shared by every strategy below ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Chunking strategy: "fixed_size" | "recursive" | "structure_aware" ---
CHUNKING_STRATEGY=fixed_size

# --- LLM provider: "openai" or "ollama" ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1

# --- Embedding provider: "ollama" | "sentence_transformers" | "openai" ---
# ollama              -> calls a running Ollama server (needs `ollama pull nomic-embed-text`)
# sentence_transformers -> runs the model locally in-process, no external service needed
# openai              -> calls the OpenAI embeddings API
EMBEDDING_PROVIDER=ollama
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# nomic-embed-text (Ollama) is asymmetric: query/document prefixes matter for retrieval quality.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_QUERY_PREFIX="search_query: "
OLLAMA_EMBEDDING_DOCUMENT_PREFIX="search_document: "

# all-MiniLM-L6-v2 (sentence-transformers) is symmetric: no prefixes, no custom model code.
SENTENCE_TRANSFORMER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_TRANSFORMER_DEVICE=cpu
SENTENCE_TRANSFORMER_TRUST_REMOTE_CODE=false
SENTENCE_TRANSFORMER_QUERY_PREFIX=
SENTENCE_TRANSFORMER_DOCUMENT_PREFIX=
# false only for the very first run on a machine that's never downloaded
# this model before — flip back to true once it's cached.
SENTENCE_TRANSFORMER_LOCAL_FILES_ONLY=true

# --- Re-ranker (pluggable: cross_encoder | cohere) ---
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Same as SENTENCE_TRANSFORMER_LOCAL_FILES_ONLY above.
RERANKER_LOCAL_FILES_ONLY=true
# Only needed when RERANKER_PROVIDER=cohere
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# --- Web search tool (pluggable: tavily) ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_MAX_RESULTS=5
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
# Max tool-calling rounds per chat turn before a final answer is forced.
CHAT_MAX_TOOL_HOPS=3
# Extra forced tool call after streaming to verify which sources the answer
# actually used, filtering citations down to just those.
CHAT_GROUNDING_ENABLED=true

# --- Chat + long-term memory (Phase 5/6) ---
CHAT_RETRIEVAL_TOP_K=5
CHAT_RETRIEVAL_CANDIDATE_LIMIT=20
CHAT_RETRIEVAL_ALPHA=0.5
SHORT_TERM_MEMORY_TURNS=10
# "sqlite" (default, no extra service needed) or "weaviate" (needs a plan
# that allows a second Weaviate collection).
MEMORY_BACKEND=sqlite

# --- Hardening (Phase 7) ---
# "text" (human-readable) or "json" (one object per line, for log aggregators)
LOG_FORMAT=text
# Postgres-only (Phase 8) — ignored while DATABASE_URL is sqlite
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
# Rate limiting, per client IP. "memory://" only works for a single
# process — point at redis:// once running multiple workers.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=20/minute
